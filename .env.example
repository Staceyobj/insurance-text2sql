# --- LLM (SPEC §8) ---
# Zhipu API key; required for eval/CLI/API, NOT needed for `make test`
ZHIPUAI_API_KEY=

# OpenAI-compatible endpoint (note: /v4, NOT /v1)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Pinned to glm-4.7 for eval and CI; glm-4.7-flash allowed for local debugging only
LLM_MODEL=glm-4.7

# Thinking mode off by default
LLM_THINKING_ENABLED=false

# Request timeout in seconds (kills hung LLM calls; slow-but-alive passes)
LLM_TIMEOUT_S=300

# --- Database ---
# Application connection (read-only role) — the only one the application may hold
DATABASE_URL=postgresql://t2s_readonly:t2s_readonly@localhost:5432/insurance

# Admin connection — seed flow only, never used at runtime
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance

# --- Pipeline ---
ROW_LIMIT=200
MAX_RETRIES=2

# --- Misc ---
LOG_LEVEL=INFO
